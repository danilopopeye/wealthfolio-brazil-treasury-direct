{
  "id": "tesouro-direto",
  "name": "Tesouro Direto",
  "version": "1.2.2",
  "description": "Daily rates and prices for Tesouro Direto bonds (Brazilian Treasury)",
  "author": "Danilo",
  "main": "dist/addon.js",
  "sdkVersion": "3.8.0",
  "minWealthfolioVersion": "3.8.0",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "tesouro-direto"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "tesouro-direto",
          "route": "tesouro-direto",
          "label": "Tesouro Direto",
          "icon": "bank",
          "order": 100
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.8.0",
    "@wealthfolio/ui": "^3.8.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "network": {
    "allowedHosts": [
      "api.tesourodiretomonitor.com.br"
    ]
  },
  "permissions": [
    {
      "category": "network",
      "functions": [
        "request"
      ],
      "purpose": "Fetch daily Tesouro Direto bond rates and prices from api.tesourodiretomonitor.com.br"
    },
    {
      "category": "accounts",
      "functions": [
        "getAll"
      ],
      "purpose": "List accounts to find securities held in your portfolio"
    },
    {
      "category": "portfolio",
      "functions": [
        "getHoldings"
      ],
      "purpose": "Read held securities to match Tesouro Direto bonds by name"
    },
    {
      "category": "assets",
      "functions": [
        "getProfile",
        "updateProfile"
      ],
      "purpose": "Check and configure the market data provider of your Tesouro Direto securities"
    },
    {
      "category": "market-data",
      "functions": [
        "sync"
      ],
      "purpose": "Trigger the first quote sync after connecting a security"
    },
    {
      "category": "quotes",
      "functions": [
        "getHistory"
      ],
      "purpose": "Check whether connected securities are actually receiving Tesouro Direto quotes"
    }
  ],
  "keywords": [
    "wealthfolio",
    "addon",
    "tesouro-direto",
    "brazil"
  ],
  "license": "MIT"
}
